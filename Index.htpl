<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buddy AI</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #101827;
      color: white;
      text-align: center;
      padding: 30px 15px;
    }
    .app {
      max-width: 500px;
      margin: auto;
      background: #1e293b;
      padding: 25px;
      border-radius: 18px;
    }
    h1 { color: #38bdf8; }
    input {
      width: 90%;
      padding: 14px;
      border-radius: 10px;
      border: none;
      margin: 10px 0;
    }
    button {
      background: #0284c7;
      color: white;
      border: none;
      padding: 13px 25px;
      border-radius: 10px;
      font-size: 16px;
    }
    #reply { margin-top: 20px; }
  </style>
</head>
<body>
  <div class="app">
    <h1>🤖 Buddy AI</h1>
    <p>Your Smart AI Friend</p>
    <input id="message" placeholder="Write your message here">
    <br>
    <button onclick="reply()">Send</button>
    <p id="reply">Hello! I am Buddy AI.</p>
  </div>

  <script>
    function reply() {
      const message = document.getElementById("message").value;
      document.getElementById("reply").innerText =
        message ? "Hello! You said: " + message : "Please write something!";
    }
  </script>
</body>
</html>
