
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1769D2">
<title>Buddy AI</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #ffffff;
  color: #202B3C;
}

.app {
  height: 100vh;
  height: 100dvh;
  display: flex;
  flex-direction: column;
}

header {
  height: 62px;
  background: #1769D2;
  color: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 15px;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 15px;
}

header h2 {
  font-size: 21px;
}

.icon-btn {
  border: none;
  background: transparent;
  color: white;
  font-size: 25px;
  cursor: pointer;
  padding: 5px;
}

#newChatBtn {
  background: white;
  color: #1769D2;
  border: none;
  padding: 9px 12px;
  border-radius: 10px;
  font-weight: bold;
}

#chatArea {
  flex: 1;
  overflow-y: auto;
  padding: 20px 14px;
  background: #F5F8FE;
}

#welcome {
  text-align: center;
  padding: 75px 15px 25px;
}

#welcome h1 {
  color: #1769D2;
  font-size: 27px;
  margin-bottom: 12px;
}

#welcome p {
  color: #66758A;
  font-size: 15px;
}

#messages {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.message {
  max-width: 85%;
  padding: 13px 16px;
  border-radius: 17px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.user-message {
  align-self: flex-end;
  background: #DCEBFF;
  color: #174D91;
  border-bottom-right-radius: 5px;
}

.ai-message {
  align-self: flex-start;
  background: #1769D2;
  color: white;
  border-bottom-left-radius: 5px;
}

#inputArea {
  background: white;
  padding: 12px;
  border-top: 1px solid #E0E8F3;
}

.inputBox {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #D5E1F0;
  border-radius: 20px;
  padding: 7px 9px;
  background: white;
}

#userInput {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  padding: 10px;
  font-size: 16px;
}

#sendBtn, #micBtn {
  width: 43px;
  height: 43px;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  font-size: 19px;
}

#sendBtn {
  background: #1769D2;
  color: white;
}

#micBtn {
  background: #E4F0FF;
  color: #1769D2;
}

.note {
  text-align: center;
  font-size: 11px;
  color: #7B8798;
  margin-top: 8px;
}

/* SIDE MENU */

#overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.35);
  z-index: 5;
}

#sideMenu {
  position: fixed;
  top: 0;
  left: -290px;
  width: 275px;
  max-width: 85%;
  height: 100%;
  background: white;
  z-index: 6;
  padding: 20px;
  transition: left 0.25s;
  box-shadow: 3px 0 15px rgba(0,0,0,0.12);
}

#sideMenu.open {
  left: 0;
}

.menuTitle {
  color: #1769D2;
  font-size: 22px;
  margin: 12px 0 25px;
}

.menuItem {
  display: block;
  width: 100%;
  text-align: left;
  padding: 14px;
  margin-bottom: 9px;
  border: none;
  border-radius: 10px;
  background: #EEF5FF;
  color: #174D91;
  font-size: 16px;
  cursor: pointer;
}

#sideMenu button:active {
  background: #D6E8FF;
}

#closeMenu {
  float: right;
  border: none;
  background: transparent;
  font-size: 25px;
  color: #1769D2;
}

</style>
</head>

<body>

<div class="app">

  <header>
    <div class="header-left">
      <button class="icon-btn" id="menuBtn">☰</button>
      <h2>💙 Buddy AI</h2>
    </div>

    <button id="newChatBtn">+ New Chat</button>
  </header>

  <main id="chatArea">

    <div id="welcome">
      <h1>Welcome to Buddy AI</h1>
      <p>Your friendly AI assistant</p>
    </div>

    <div id="messages"></div>

  </main>

  <div id="inputArea">
    <div class="inputBox">
      <input
        type="text"
        id="userInput"
        placeholder="Message Buddy AI..."
      >

      <button id="micBtn" type="button">🎤</button>
      <button id="sendBtn" type="button">➤</button>
    </div>

    <p class="note">
      Buddy AI can make mistakes. Check important information.
    </p>
  </div>

</div>

<div id="overlay"></div>

<nav id="sideMenu">
  <button id="closeMenu">×</button>

  <h2 class="menuTitle">💙 Buddy AI</h2>

  <button class="menuItem" id="menuNewChat">＋ New Chat</button>
  <button class="menuItem" id="historyBtn">💬 Chat History</button>
  <button class="menuItem" id="loginBtn">👤 Login</button>
  <button class="menuItem" id="settingsBtn">⚙️ Settings</button>
</nav>

<script>
const menuBtn = document.getElementById("menuBtn");
const closeMenu = document.getElementById("closeMenu");
const sideMenu = document.getElementById("sideMenu");
const overlay = document.getElementById("overlay");

const sendBtn = document.getElementById("sendBtn");
const newChatBtn = document.getElementById("newChatBtn");
const menuNewChat = document.getElementById("menuNewChat");

const userInput = document.getElementById("userInput");
const messages = document.getElementById("messages");
const welcome = document.getElementById("welcome");
const chatArea = document.getElementById("chatArea");

function openMenu() {
  sideMenu.classList.add("open");
  overlay.style.display = "block";
}

function closeSideMenu() {
  sideMenu.classList.remove("open");
  overlay.style.display = "none";
}

menuBtn.addEventListener("click", openMenu);
closeMenu.addEventListener("click", closeSideMenu);
overlay.addEventListener("click", closeSideMenu);

function startNewChat() {
  messages.innerHTML = "";
  userInput.value = "";
  welcome.style.display = "block";
  closeSideMenu();
}

newChatBtn.addEventListener("click", startNewChat);
menuNewChat.addEventListener("click", startNewChat);

function sendMessage() {
  const message = userInput.value.trim();

  if (!message) return;

  const messageBox = document.createElement("div");
  messageBox.className = "message user-message";
  messageBox.textContent = message;

  messages.appendChild(messageBox);

  userInput.value = "";
  welcome.style.display = "none";

  chatArea.scrollTop = chatArea.scrollHeight;
}

sendBtn.addEventListener("click", sendMessage);

userInput.addEventListener("keydown", function(event) {
  if (event.key === "Enter") {
    sendMessage();
  }
});

document.getElementById("historyBtn").addEventListener("click", function() {
  closeSideMenu();
  alert("Chat History will be added next.");
});

document.getElementById("loginBtn").addEventListener("click", function() {
  closeSideMenu();
  alert("Login feature will be added next.");
});

document.getElementById("settingsBtn").addEventListener("click", function() {
  closeSideMenu();
  alert("Settings will be added next.");
});
</script>

</body>
</html>
